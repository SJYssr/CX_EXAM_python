<Window x:Class="CxExamClient.WindowSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口选择器 - 选择要保护的窗口" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <Border Grid.Row="0" Background="#f0f0f0" Padding="10" Margin="5">
            <StackPanel>
                <TextBlock Text="窗口防录屏保护器" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="选择要应用防录屏保护的窗口。勾选后点击应用即可保护相应窗口。" 
                          FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="💡 提示：输入法候选词窗口通常标题为空或包含'候选'、'输入法'等关键词" 
                          FontSize="10" Foreground="Blue" Margin="0,5,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 窗口列表 -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 列标题 -->
                <Grid Grid.Row="0" Background="#e0e0e0" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="选择" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="句柄" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="窗口标题" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="窗口类名" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="状态" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Grid>

                <!-- 窗口列表 -->
                <ListView Grid.Row="1" x:Name="WindowListView" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="句柄" Width="100" DisplayMemberBinding="{Binding Handle}"/>
                            <GridViewColumn Header="窗口标题" Width="300" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="窗口类名" Width="200" DisplayMemberBinding="{Binding ClassName}"/>
                            <GridViewColumn Header="状态" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" 
                                                  Foreground="{Binding StatusColor}" 
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <DockPanel Grid.Row="2" Margin="5" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="🔄 刷新窗口列表" Width="120" Height="30" 
                       Click="RefreshButton_Click" Margin="0,0,10,0"/>
                <Button x:Name="SelectImeOnlyButton" Content="📝 仅选输入法" Width="100" Height="30" 
                       Click="SelectImeOnlyButton_Click" Margin="0,0,10,0" Background="LightBlue"/>
                <Button x:Name="UnselectAllButton" Content="取消全选" Width="80" Height="30" 
                       Click="UnselectAllButton_Click" Margin="0,0,10,0"/>
            </StackPanel>
            
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="准备就绪" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Button x:Name="TestApiButton" Content="🧪 测试API" Width="80" Height="30" 
                       Click="TestApiButton_Click" Margin="0,0,10,0" Background="LightYellow"/>
                <Button x:Name="RealTimeImeButton" Content="🔍 实时输入法" Width="100" Height="30" 
                       Click="RealTimeImeButton_Click" Margin="0,0,10,0" Background="LightCyan"/>
                <Button x:Name="ApplyButton" Content="✅ 应用保护" Width="100" Height="30" 
                       Click="ApplyButton_Click" Margin="0,0,10,0" Background="LightGreen"/>
                <Button x:Name="RemoveButton" Content="❌ 移除保护" Width="100" Height="30" 
                       Click="RemoveButton_Click" Margin="0,0,10,0" Background="LightCoral"/>
                <Button x:Name="CloseButton" Content="关闭" Width="60" Height="30" 
                       Click="CloseButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window> 